# ---- Frontend (Vite) ----
# Supabase local: chạy `supabase status` để lấy URL và anon key
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Token Cesium ion (tuỳ chọn). Bỏ trống → EllipsoidTerrainProvider + OSM imagery
VITE_CESIUM_TOKEN=
# Dịch cao độ dữ liệu khi hiển thị trên Cesium World Terrain (m), mặc định 0
VITE_HEIGHT_OFFSET=0

# ---- Script seed / test ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
